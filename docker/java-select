#!/bin/sh
# Executado no lugar de /usr/bin/java dentro do container.
# O painel (runner exec) define CRAFTBOX_JAVA_MAJOR=8|17|21|25 por instância,
# conforme a versão do Minecraft (meta mcVersion): 8 = MC <=1.16, 17 = 1.17–1.20.4,
# 21 = 1.20.5+/1.21.x, 25 = versões por calendário (26.1+). Sem isso, cai no JDK 21.
case "${CRAFTBOX_JAVA_MAJOR:-21}" in
  8)  J="/usr/local/lib/jvm/jdk8/bin/java" ;;
  17) J="/usr/local/lib/jvm/jdk17/bin/java" ;;
  25) J="/usr/local/lib/jvm/jdk25/bin/java" ;;
  21|*) J="/usr/local/lib/jvm/jdk21/bin/java" ;;
esac
exec "$J" "$@"
