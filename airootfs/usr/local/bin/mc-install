#!/usr/bin/env bash
#
# mc-install — instalador do craftbox (appliance de servidor Minecraft, Arch Linux)
#
# Assistente em tela cheia no estilo do instalador do Ubuntu Server: uma tela por
# etapa (Continuar/Voltar), nada é gravado no disco até a confirmação final, e a
# instalação roda com uma tela de progresso + log completo em /tmp.
#
#   mc-install              instala de verdade (APAGA o disco escolhido no fim)
#   mc-install --dry-run    percorre todas as telas e SIMULA a instalação (não toca em nada)
#
set -uo pipefail

CB_VERSION=$(sed -n 's/^VERSION=//p' /etc/craftbox-release 2>/dev/null); CB_VERSION=${CB_VERSION:-dev}
DRYRUN=false
[ "${1:-}" = "--dry-run" ] && DRYRUN=true
DIALOG=${DIALOG:-dialog}
LOG=${CB_LOG:-/tmp/craftbox-install.log}
STATE=/tmp/craftbox-install.state
UA="mc-install/$CB_VERSION (github.com/Vascon11/craftbox)"
# units, sudoers e lista de pacotes: fonte única compartilhada com o craftbox-update
# shellcheck source=/dev/null
. /usr/local/lib/craftbox/system.sh
export LANG=${LANG:-C.UTF-8}
NL=$'\n'

# escolhas do usuário (preenchidas pelas telas)
KEYMAP=br-abnt2
WIFI_IF=""; WIFI_SSID=""; WIFI_PASS=""; WIFI_HIDDEN=false
STATIC_IF=""; STATIC_ADDR=""; STATIC_GW=""; STATIC_DNS="1.1.1.1,8.8.8.8"
DISK=""; P1=""; P2=""
FULLNAME=""; SRV_HOST="craftbox"; USERNAME=""; USERPW=""
SSH_KEYS=""; SSH_PWAUTH=true
MCTYPE=nenhum; MCVER=""; SRVNAME="Principal"; MC_MOTD="Um servidor craftbox"; MC_MAXP=8; MC_DIFF=normal
OPTIMIZE=true; EULA=false
PANELPW=""; PANEL_SAME=true

# ---------------------------------------------------------------------------
# visual (dialog) — paleta inspirada no instalador do Ubuntu Server
# ---------------------------------------------------------------------------
DW=76; DH=21
fit_screen() {
  local c l; c=$(tput cols 2>/dev/null || echo 80); l=$(tput lines 2>/dev/null || echo 25)
  DW=$(( c - 4 < 76 ? c - 4 : 76 )); DH=$(( l - 4 < 21 ? l - 4 : 21 ))
}
setup_theme() {
  if [ "${TERM:-}" = linux ]; then
    # fonte do console: a padrão (CP437) não tem ã/õ; Terminus tem, e fica maior/legível
    local rows f; rows=$(tput lines 2>/dev/null || echo 25)
    if (( rows >= 45 )); then f=ter-v24n; elif (( rows >= 34 )); then f=ter-v20n; else f=ter-v16n; fi
    setfont "$f" 2>/dev/null || setfont eurlatgr 2>/dev/null || true
    dmesg -n 1 2>/dev/null   # mensagens do kernel não pisam nas telas
  fi
  if [ "${TERM:-}" = linux ]; then
    printf '\e]P3E95420'   # "amarelo"  -> laranja do Ubuntu (destaques)
    printf '\e]PBE95420'   # amarelo claro -> laranja
    printf '\e]P4333333'   # "azul"     -> cinza escuro (campos de texto)
    printf '\e]P0111111'   # preto      -> quase preto
  fi
  local rc=/tmp/craftbox-dialogrc
  cat > "$rc" <<'EOF'
use_shadow = OFF
use_colors = ON
screen_color = (WHITE,BLACK,ON)
shadow_color = (BLACK,BLACK,ON)
dialog_color = (WHITE,BLACK,OFF)
title_color = (YELLOW,BLACK,ON)
border_color = (WHITE,BLACK,OFF)
border2_color = (WHITE,BLACK,OFF)
button_active_color = (WHITE,YELLOW,ON)
button_inactive_color = (WHITE,BLACK,OFF)
button_key_active_color = (WHITE,YELLOW,ON)
button_key_inactive_color = (YELLOW,BLACK,ON)
button_label_active_color = (WHITE,YELLOW,ON)
button_label_inactive_color = (WHITE,BLACK,ON)
inputbox_color = (WHITE,BLUE,ON)
inputbox_border_color = (WHITE,BLACK,OFF)
inputbox_border2_color = (WHITE,BLACK,OFF)
searchbox_color = (WHITE,BLACK,OFF)
searchbox_title_color = (YELLOW,BLACK,ON)
searchbox_border_color = (WHITE,BLACK,OFF)
searchbox_border2_color = (WHITE,BLACK,OFF)
position_indicator_color = (YELLOW,BLACK,ON)
menubox_color = (WHITE,BLACK,OFF)
menubox_border_color = (WHITE,BLACK,OFF)
menubox_border2_color = (WHITE,BLACK,OFF)
item_color = (WHITE,BLACK,OFF)
item_selected_color = (WHITE,YELLOW,ON)
tag_color = (WHITE,BLACK,ON)
tag_selected_color = (WHITE,YELLOW,ON)
tag_key_color = (WHITE,BLACK,ON)
tag_key_selected_color = (WHITE,YELLOW,ON)
check_color = (WHITE,BLACK,OFF)
check_selected_color = (WHITE,YELLOW,ON)
uarrow_color = (YELLOW,BLACK,ON)
darrow_color = (YELLOW,BLACK,ON)
itemhelp_color = (WHITE,BLACK,OFF)
form_active_text_color = (WHITE,YELLOW,ON)
form_text_color = (WHITE,BLUE,ON)
form_item_readonly_color = (WHITE,BLACK,OFF)
gauge_color = (YELLOW,BLUE,OFF)
EOF
  export DIALOGRC=$rc
}
EXIT_MSG=""
restore_screen() { [ "${TERM:-}" = linux ] && printf '\e]R'; clear; [ -n "$EXIT_MSG" ] && echo "$EXIT_MSG"; }
trap restore_screen EXIT

BT=""; STEP_NO=0; STEP_N=0
bt() { BT="craftbox $CB_VERSION  ·  Instalador$($DRYRUN && echo '  ·  SIMULAÇÃO')      passo $STEP_NO de $STEP_N: $1"; }
# dialog com a escolha no stdout; código 0=ok 1=voltar 3=extra 255=esc
# altura 0 = calcula pelo conteúdo (o auto-size do dialog erra com --cr-wrap)
D() {
  local -a a=("$@"); local i l n t
  for i in "${!a[@]}"; do
    case "${a[i]}" in --menu|--yesno|--msgbox)
      [ "${a[i+2]:-}" = 0 ] || continue
      t=${a[i+1]//\\n/$NL}; l=$(printf '%s' "$t" | wc -l)
      if [ "${a[i]}" = --menu ]; then
        n=$(( (${#a[@]} - i - 5) / 2 )); a[i+2]=$(( l + n + 6 ))
        if (( a[i+2] > DH )); then a[i+2]=$DH; n=$(( DH - l - 6 )); (( n < 2 )) && n=2; fi
        a[i+4]=$n
      else
        a[i+2]=$(( l + 5 )); (( a[i+2] > DH )) && a[i+2]=$DH
      fi ;;
    esac
  done
  "$DIALOG" --backtitle "$BT" --colors --no-collapse --cr-wrap "${a[@]}" 3>&1 1>&2 2>&3
}
msg() { D --title " ${2:-Aviso} " --ok-label "Ok" --msgbox "\n$1\n" "${3:-0}" "$DW"; }

# roda uma lista de telas; cada tela retorna 0 (avançar) ou !=0 (voltar)
wizard() {
  local -a steps=("$@"); local i=0 n=${#steps[@]}
  while (( i < n )); do
    if "${steps[i]}"; then i=$((i + 1)); else (( i == 0 )) && return 1; i=$((i - 1)); fi
  done
}
# WIZ_START: índice da tela inicial (usado pra voltar direto ao resumo depois de um erro)
top_wizard() {
  local -a steps=("$@"); local i=${WIZ_START:-0} n=${#steps[@]}
  STEP_N=$n
  while (( i < n )); do
    STEP_NO=$((i + 1))
    if "${steps[i]}"; then i=$((i + 1)); else (( i > 0 )) && i=$((i - 1)); fi
  done
}

# ---------------------------------------------------------------------------
# utilidades
# ---------------------------------------------------------------------------
net_online() { curl -fsS -m 6 -o /dev/null https://archlinux.org 2>/dev/null || ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; }
net_ifaces() { local i; for i in $(ls /sys/class/net 2>/dev/null); do case "$i" in en*|eth*|wl*) echo "$i";; esac; done; }
if_ip() { ip -4 -o addr show dev "$1" 2>/dev/null | awk '{print $4}' | head -1; }
if_gw() { ip -4 route show default dev "$1" 2>/dev/null | awk '{print $3; exit}'; }
valid_cidr() { [[ $1 =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})/([0-9]{1,2})$ ]] && (( BASH_REMATCH[1] < 256 && BASH_REMATCH[2] < 256 && BASH_REMATCH[3] < 256 && BASH_REMATCH[4] < 256 && BASH_REMATCH[5] <= 32 )); }
valid_ip() { valid_cidr "$1/32"; }
# disco de onde o live bootou (não pode ser o alvo)
live_disk() { local src; src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null) || return 0; [ -n "$src" ] && lsblk -no PKNAME "$src" 2>/dev/null | head -1 | sed 's|^|/dev/|'; }
human_ram() { free -m | awk '/^Mem:/{printf "%.1f GB", $2/1024}'; }
# heap do 1º servidor: RAM - 2 GB (até 6 GB). Com ≤4,5 GB isso deixava o SO + painel
# sem folga e a máquina entrava em swap thrashing no HD (achado no Dell de 4 GB),
# então aí fica em 35% da RAM (mín. 1 GB).
heap_mb() {
  local t h; t=$(free -m | awk '/^Mem:/{print $2}')
  if (( t <= 4608 )); then h=$(( t * 35 / 100 )); else h=$(( t - 2048 )); fi
  (( h < 1024 )) && h=1024; (( h > 6144 )) && h=6144; echo "$h"
}
part_names() { if [[ "$DISK" == *nvme* || "$DISK" == *mmcblk* ]]; then P1="${DISK}p1"; P2="${DISK}p2"; else P1="${DISK}1"; P2="${DISK}2"; fi; }

# ---------------------------------------------------------------------------
# 1) Bem-vindo
# ---------------------------------------------------------------------------
scr_welcome() {
  bt "Bem-vindo"
  local cpu fw c
  cpu=$(awk -F: '/model name/{print $2; exit}' /proc/cpuinfo | sed 's/^ *//;s/(R)//g;s/(TM)//g;s/ CPU//;s/  */ /g')
  if [ -d /sys/firmware/efi ]; then fw="UEFI"; else fw="BIOS legado (\Z1não suportado\Zn)"; fi
  while :; do
    c=$(D --title " Bem-vindo ao craftbox! " --no-tags --no-cancel --ok-label "Selecionar" --menu \
"
Este assistente transforma esta máquina num servidor de Minecraft
dedicado: sistema enxuto, painel web, backups diários e acesso SSH.

   Processador:  ${cpu:-?}
   Memória:      $(human_ram)
   Firmware:     $fw

Nada é gravado no disco até você confirmar no final.
Use as \Zbsetas\Zn, \ZbEnter\Zn para escolher e \ZbTab\Zn para trocar de botão.
" 0 "$DW" 0 \
      instalar "Instalar o craftbox" \
      terminal "Abrir um terminal (modo avançado)" \
      desligar "Desligar a máquina") || continue
    case "$c" in
      instalar)
        if [ ! -d /sys/firmware/efi ] && ! $DRYRUN; then
          msg "Esta máquina bootou em modo \ZbBIOS legado\Zn.\n\nO craftbox precisa de \ZbUEFI\Zn: entre no setup da BIOS, ative o modo UEFI (desligando o Legacy/CSM) e dê boot pelo pendrive de novo." "Modo de boot não suportado"
          continue
        fi
        return 0 ;;
      terminal) EXIT_MSG="Para voltar ao instalador, digite: mc-install"; exit 0 ;;
      desligar) $DRYRUN && exit 0; poweroff ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# 2) Teclado
# ---------------------------------------------------------------------------
scr_keyboard() {
  bt "Teclado"
  local k
  while :; do
    k=$(D --title " Layout do teclado " --ok-label "Continuar" --cancel-label "Voltar" --default-item "$KEYMAP" --menu \
"
Escolha o layout do seu teclado. Ele passa a valer na hora, e você
vai poder testar na próxima tela.
" 0 "$DW" 0 \
      br-abnt2   "Português (Brasil) — ABNT2, com a tecla Ç" \
      us-acentos "Inglês (EUA) internacional, com acentos" \
      us         "Inglês (EUA)" \
      pt-latin1  "Português (Portugal)" \
      es         "Espanhol" \
      uk         "Inglês (Reino Unido)" \
      fr-latin1  "Francês" \
      de-latin1  "Alemão") || return 1
    KEYMAP=$k
    $DRYRUN || loadkeys "$KEYMAP" >/dev/null 2>&1
    D --title " Testar o teclado " --ok-label "Está certo" --cancel-label "Trocar layout" --inputbox \
"
Digite alguns caracteres especiais (ç ã é / ? ;) para conferir se o
layout está certo. O texto não é salvo.
" 10 "$DW" "" >/dev/null && return 0
  done
}

# ---------------------------------------------------------------------------
# 3) Rede
# ---------------------------------------------------------------------------
net_table() {
  local i typ st ip mode ssid
  echo "  INTERFACE    TIPO    ESTADO     ENDEREÇO            MODO"   # literal: printf conta bytes e o Ç desalinha
  for i in $(net_ifaces); do
    case "$i" in wl*) typ="Wi-Fi";; *) typ="Cabo";; esac
    st=$(cat "/sys/class/net/$i/operstate" 2>/dev/null)
    case "$st" in up) st="ligada";; down) st="desligada";; *) st="—";; esac
    ip=$(if_ip "$i")
    mode="DHCP"; [ "$i" = "$STATIC_IF" ] && mode="IP fixo"
    ssid=""; [ "$i" = "$WIFI_IF" ] && [ -n "$WIFI_SSID" ] && ssid=" ($WIFI_SSID)"
    printf '  %-12s %-7s %-10s %-19s %s\n' "$i" "$typ" "$st" "${ip:-sem IP}" "$mode$ssid"
  done
}
wifi_connect() {
  local wl ssid pass line sec sig c k
  wl=$(net_ifaces | grep '^wl' | head -1)
  [ -z "$wl" ] && { msg "Nenhuma placa Wi-Fi foi encontrada. Use o cabo de rede."; return; }
  D --title " Wi-Fi " --infobox "\n  Procurando redes Wi-Fi..." 5 40
  local -a items=()
  if ! $DRYRUN; then
    iwctl station "$wl" scan >/dev/null 2>&1; sleep 4
    while IFS= read -r line; do
      line=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$line")
      if [[ $line =~ ^[[:space:]]*(\>[[:space:]]+)?(.*[^[:space:]])[[:space:]]+(psk|open|8021x|wep)[[:space:]]+(\*+)[[:space:]]*$ ]]; then
        ssid=${BASH_REMATCH[2]}; sec=${BASH_REMATCH[3]}; sig=${BASH_REMATCH[4]}
        case "$sec" in psk) sec="com senha";; open) sec="aberta";; *) sec="$sec (não suportada)";; esac
        items+=("$ssid" "$(printf '%-5s %s' "$sig" "$sec")")
      fi
    done < <(iwctl station "$wl" get-networks 2>/dev/null)
  else
    items+=("Casa 5G" "****  com senha" "Vizinho" "**    com senha")
  fi
  items+=("<outra>" "Rede oculta (digitar o nome)")
  c=$(D --title " Redes Wi-Fi em $wl " --ok-label "Conectar" --cancel-label "Voltar" --menu "\nEscolha a rede:\n" 0 "$DW" 0 "${items[@]}") || return
  WIFI_HIDDEN=false
  if [ "$c" = "<outra>" ]; then
    c=$(D --title " Rede oculta " --ok-label "Continuar" --cancel-label "Voltar" --inputbox "\nNome da rede (SSID):\n" 10 "$DW" "") || return
    [ -z "$c" ] && return
    WIFI_HIDDEN=true
  fi
  pass=$(D --title " Senha de \"$c\" " --ok-label "Conectar" --cancel-label "Voltar" --insecure --passwordbox "\nSenha do Wi-Fi (deixe vazio se a rede for aberta):\n" 10 "$DW") || return
  D --title " Wi-Fi " --infobox "\n  Conectando em \"$c\"..." 5 50
  if ! $DRYRUN; then
    local -a args=(); [ -n "$pass" ] && args=(--passphrase "$pass")
    if $WIFI_HIDDEN; then iwctl "${args[@]}" station "$wl" connect-hidden "$c" >/dev/null 2>&1
    else iwctl "${args[@]}" station "$wl" connect "$c" >/dev/null 2>&1; fi
    for k in $(seq 1 20); do net_online && break; sleep 1; done
  else sleep 1; fi
  if $DRYRUN || net_online; then
    WIFI_IF=$wl; WIFI_SSID=$c; WIFI_PASS=$pass
    msg "Conectado em \"$c\". Essa rede fica salva no sistema instalado." "Wi-Fi"
  else
    msg "Não consegui internet pela rede \"$c\".\n\nConfira a senha e se o sinal está bom, ou use o cabo de rede." "Wi-Fi"
  fi
}
static_apply_live() {
  $DRYRUN && return
  mkdir -p /run/systemd/network
  { printf '[Match]\nName=%s\n\n[Network]\nAddress=%s\nGateway=%s\n' "$STATIC_IF" "$STATIC_ADDR" "$STATIC_GW"
    local d; for d in ${STATIC_DNS//,/ }; do printf 'DNS=%s\n' "$d"; done
  } > /run/systemd/network/10-craftbox-static.network
  networkctl reload >/dev/null 2>&1; networkctl reconfigure "$STATIC_IF" >/dev/null 2>&1; sleep 3
}
static_ip() {
  local -a ifs items=() v; local i ifc vals ok d
  mapfile -t ifs < <(net_ifaces)
  [ ${#ifs[@]} -eq 0 ] && { msg "Nenhuma interface de rede encontrada."; return; }
  if [ ${#ifs[@]} -eq 1 ]; then ifc=${ifs[0]}
  else
    for i in "${ifs[@]}"; do items+=("$i" "$(if_ip "$i")"); done
    ifc=$(D --title " IP fixo " --ok-label "Continuar" --cancel-label "Voltar" --menu "\nEm qual interface?\n" 0 "$DW" 0 "${items[@]}") || return
  fi
  local addr=${STATIC_ADDR:-$(if_ip "$ifc")} gw=${STATIC_GW:-$(if_gw "$ifc")} dns=$STATIC_DNS
  while :; do
    vals=$(D --title " IP fixo — $ifc " --ok-label "Salvar" --cancel-label "Voltar" --form \
"
Com IP fixo o servidor tem sempre o mesmo endereço na rede local: é
o que você usa no redirecionamento de portas do roteador. Escolha um
endereço fora da faixa de DHCP do roteador. No DNS, separe com vírgula.
" 13 "$DW" 3 \
      "        Endereço/prefixo:" 1 1 "$addr" 1 27 22 18 \
      "     Gateway (roteador):" 2 1 "$gw"   2 27 22 15 \
      "         Servidores DNS:" 3 1 "$dns"  3 27 40 64) || return
    mapfile -t v <<<"$vals"; addr=${v[0]:-}; gw=${v[1]:-}; dns=${v[2]:-}
    if ! valid_cidr "$addr"; then msg "Endereço inválido: use o formato \Zb192.168.0.50/24\Zn."; continue; fi
    if ! valid_ip "$gw"; then msg "Gateway inválido (ex: \Zb192.168.0.1\Zn)."; continue; fi
    ok=true; for d in ${dns//,/ }; do valid_ip "$d" || ok=false; done
    if ! $ok || [ -z "$dns" ]; then msg "DNS inválido (ex: \Zb1.1.1.1,8.8.8.8\Zn)."; continue; fi
    break
  done
  STATIC_IF=$ifc; STATIC_ADDR=$addr; STATIC_GW=$gw; STATIC_DNS=$dns
  D --infobox "\n  Aplicando o IP fixo..." 5 40
  static_apply_live
}
static_off() {
  STATIC_IF=""; STATIC_ADDR=""; STATIC_GW=""
  $DRYRUN && return
  rm -f /run/systemd/network/10-craftbox-static.network
  networkctl reload >/dev/null 2>&1; local i; for i in $(net_ifaces); do networkctl reconfigure "$i" >/dev/null 2>&1; done; sleep 3
}
scr_network() {
  bt "Rede"
  local online c status
  while :; do
    D --infobox "\n  Testando a conexão com a internet..." 5 46
    if $DRYRUN || net_online; then online=true; status="\Z2\ZbConectado à internet.\Zn"
    else online=false; status="\Z1\ZbSem internet.\Zn A instalação baixa o sistema e o Minecraft, então precisa de rede."; fi
    local -a items=()
    $online && items+=(continuar "Continuar")
    net_ifaces | grep -q '^wl' && items+=(wifi "Conectar a uma rede Wi-Fi")
    items+=(ipfixo "Configurar IP fixo (recomendado para servidor)")
    [ -n "$STATIC_IF" ] && items+=(dhcp "Voltar para IP automático (DHCP)")
    items+=(testar "Testar a conexão de novo")
    c=$(D --title " Conexões de rede " --no-tags --ok-label "Selecionar" --cancel-label "Voltar" --menu \
"
$(net_table)

$status
" 0 "$DW" 0 "${items[@]}") || return 1
    case "$c" in
      continuar) return 0 ;;
      wifi) wifi_connect ;;
      ipfixo) static_ip ;;
      dhcp) static_off ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# 4) Armazenamento
# ---------------------------------------------------------------------------
scr_storage() {
  bt "Armazenamento"
  local skip name size model fs c total existing
  skip=$(live_disk)
  while :; do
    local -a items=()
    while read -r name size model; do
      [ "$name" = "$skip" ] && continue
      fs=$(lsblk -nlo FSTYPE "$name" 2>/dev/null | grep -v '^$' | sort -u | tr '\n' ' ' | sed 's/ $//')
      [ -n "$fs" ] && fs="contém: $fs" || fs="vazio"
      items+=("$name" "$(printf '%7s  %-20.20s  %.28s' "$size" "${model:-(sem nome)}" "$fs")")
    done < <(lsblk -dnpo NAME,SIZE,MODEL -e 7,11,251 2>/dev/null | grep -v zram)
    if [ ${#items[@]} -eq 0 ]; then msg "Nenhum disco foi encontrado para instalar." "Armazenamento"; return 1; fi
    c=$(D --title " Onde instalar? " --ok-label "Continuar" --cancel-label "Voltar" ${DISK:+--default-item "$DISK"} --menu \
"
Escolha o disco. O craftbox usa o \Zbdisco inteiro\Zn: tudo o que houver
nele (outros sistemas, arquivos) será apagado na hora de instalar.
" 0 "$DW" 0 "${items[@]}") || return 1
    DISK=$c; part_names
    total=$(lsblk -dno SIZE "$DISK" | tr -d ' ')
    existing=$(lsblk -lpo NAME,SIZE,FSTYPE,LABEL "$DISK" 2>/dev/null | sed '2d; s/^/    /')
    [ "$(grep -c . <<<"$existing")" -le 1 ] && existing="    (disco vazio, sem partições)"
    D --title " Resumo do armazenamento " --yes-label "Continuar" --no-label "Voltar" --yesno \
"
Disco: \Zb$DISK\Zn ($total)

O que será criado:
$(printf '    %-14s %8s  %-8s %s' "$P1" "512M" "FAT32" "/boot  (partição EFI)")
$(printf '    %-14s %8s  %-8s %s' "$P2" "resto" "ext4" "/      (sistema + servidores)")
    arquivo de swap de 2 GB em /swapfile

\Z1\ZbSerá APAGADO:\Zn
$existing
" 0 "$DW" && return 0
  done
}

# ---------------------------------------------------------------------------
# 5) Perfil
# ---------------------------------------------------------------------------
scr_profile() {
  bt "Perfil"
  local vals p2; local -a v
  while :; do
    vals=$(D --title " Configuração do perfil " --ok-label "Continuar" --cancel-label "Voltar" --insecure --mixedform \
"
Digite o usuário e a senha que você vai usar para entrar na máquina
(pelo SSH ou direto no teclado). O nome do servidor identifica a
máquina na rede.
" 15 "$DW" 5 \
      "               Seu nome:" 1 1 "$FULLNAME" 1 26 40 64 0 \
      "       Nome do servidor:" 2 1 "$SRV_HOST" 2 26 40 63 0 \
      "        Nome de usuário:" 3 1 "$USERNAME" 3 26 40 32 0 \
      "                  Senha:" 4 1 "" 4 26 40 128 1 \
      "       Confirme a senha:" 5 1 "" 5 26 40 128 1) || return 1
    mapfile -t v <<<"$vals"
    FULLNAME=${v[0]:-}; SRV_HOST=${v[1]:-}; USERNAME=${v[2]:-}; USERPW=${v[3]:-}; p2=${v[4]:-}
    FULLNAME=${FULLNAME//[:\\]/}
    if ! [[ $SRV_HOST =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
      msg "Nome do servidor inválido.\n\nUse só letras minúsculas, números e hífen (ex: \Zbcraftbox\Zn ou \Zbmc-casa\Zn)."; continue; fi
    if ! [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
      msg "Nome de usuário inválido.\n\nUse letras minúsculas, números, _ ou -, começando por letra (ex: \Zbjoao\Zn)."; continue; fi
    case "$USERNAME" in root|minecraft|bin|daemon|nobody|mail|ftp|http|git) msg "O usuário \Zb$USERNAME\Zn é reservado pelo sistema. Escolha outro."; continue;; esac
    if [ ${#USERPW} -lt 6 ]; then msg "A senha precisa ter pelo menos 6 caracteres."; continue; fi
    if [ "$USERPW" != "$p2" ]; then msg "As senhas não batem. Digite de novo."; continue; fi
    $PANEL_SAME && PANELPW=$USERPW
    return 0
  done
}

# ---------------------------------------------------------------------------
# 6) SSH
# ---------------------------------------------------------------------------
ssh_count() { if [ -z "$SSH_KEYS" ]; then echo 0; else grep -c . <<<"$SSH_KEYS"; fi; }
ssh_add_keys() {
  local keys=$1 fp n
  fp=$(ssh-keygen -lf <(printf '%s\n' "$keys") 2>/dev/null | awk '{print "   " $1 " " $2 " " $NF}')
  [ -z "$fp" ] && { msg "Não reconheci nenhuma chave SSH válida."; return; }
  n=$(grep -c . <<<"$fp")
  D --title " Confirmar chaves " --yes-label "Importar" --no-label "Voltar" --yesno "\nEncontrei $n chave(s):\n\n$fp\n" 0 "$DW" || return
  SSH_KEYS=$(printf '%s\n%s\n' "$SSH_KEYS" "$keys" | grep -E '^(ssh-|ecdsa-|sk-)' | sort -u)
}
scr_ssh() {
  bt "SSH"
  local c u keys pwl
  while :; do
    if $SSH_PWAUTH; then pwl="\Z2permitido\Zn"; else pwl="\Z1bloqueado\Zn (só chave)"; fi
    local -a items=(continuar "Continuar" github "Importar chaves do GitHub" colar "Colar uma chave pública")
    [ "$(ssh_count)" -gt 0 ] && items+=(senha "Permitir/bloquear login SSH com senha" limpar "Remover as chaves importadas")
    c=$(D --title " Acesso SSH " --no-tags --ok-label "Selecionar" --cancel-label "Voltar" --menu \
"
O servidor OpenSSH já vem instalado: é por ele que você administra a
máquina de outro computador (ssh usuario@ip).

Com uma \Zbchave SSH\Zn você entra sem digitar senha. O jeito mais fácil é
importar as chaves públicas da sua conta do GitHub.

   Chaves importadas:     $(ssh_count)
   Login SSH com senha:   $pwl
" 0 "$DW" 0 "${items[@]}") || return 1
    case "$c" in
      continuar) return 0 ;;
      github)
        u=$(D --title " Importar do GitHub " --ok-label "Buscar" --cancel-label "Voltar" --inputbox "\nSeu usuário do GitHub:\n" 10 "$DW" "") || continue
        [[ $u =~ ^[A-Za-z0-9-]{1,39}$ ]] || { msg "Usuário do GitHub inválido."; continue; }
        D --infobox "\n  Buscando as chaves de $u..." 5 50
        keys=$(curl -fsSL -m 15 -A "$UA" "https://github.com/$u.keys" 2>/dev/null)
        [ -z "$keys" ] && { msg "Não achei chaves públicas no GitHub para \Zb$u\Zn.\n\n(Confira em https://github.com/$u.keys)"; continue; }
        ssh_add_keys "$keys" ;;
      colar)
        keys=$(D --title " Colar chave pública " --ok-label "Adicionar" --cancel-label "Voltar" --inputbox "\nCole a chave (começa com ssh-ed25519, ssh-rsa, ecdsa-...):\n" 10 "$DW" "") || continue
        ssh_add_keys "$keys" ;;
      senha) if $SSH_PWAUTH; then SSH_PWAUTH=false; else SSH_PWAUTH=true; fi ;;
      limpar) SSH_KEYS=""; SSH_PWAUTH=true ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# 7) Minecraft (subetapas)
# ---------------------------------------------------------------------------
declare -A VCACHE=()
mc_versions() {
  if [ -z "${VCACHE[$MCTYPE]:-}" ]; then
    D --infobox "\n  Buscando versões do Minecraft..." 5 46
    if [ "$MCTYPE" = paper ]; then
      VCACHE[$MCTYPE]=$(curl -fsSL -m 15 -A "$UA" https://fill.papermc.io/v3/projects/paper | jq -r '[.versions[][] | select(test("-")|not)][:20][]' 2>/dev/null)
    else
      VCACHE[$MCTYPE]=$(curl -fsSL -m 15 -A "$UA" https://meta.fabricmc.net/v2/versions/game | jq -r '[.[]|select(.stable==true)][:20][].version' 2>/dev/null)
    fi
  fi
  printf '%s' "${VCACHE[$MCTYPE]}"
}
mc_type() {
  local c
  c=$(D --title " Tipo de servidor " --no-tags --ok-label "Continuar" --cancel-label "Voltar" --default-item "$MCTYPE" --menu \
"
Criar um servidor de Minecraft já na instalação?

Não é obrigatório: escolhendo \ZbNenhum agora\Zn, só o sistema e o painel são
instalados, sem baixar servidor nem gerar mundo. Pelo painel web você
cria quantos quiser depois, inclusive \ZbForge\Zn, \ZbNeoForge\Zn e \Zbmodpacks\Zn.
" 0 "$DW" 0 \
    nenhum "Nenhum agora: crio pelo painel depois" \
    paper  "Paper: plugins, leve (recomendado para PC fraco)" \
    fabric "Fabric: mods (os jogadores instalam os mesmos mods)") || return 1
  [ "$c" != "$MCTYPE" ] && MCVER=""
  MCTYPE=$c
}
mc_version() {
  local list c v first=""
  list=$(mc_versions)
  if [ -z "$list" ]; then
    c=$(D --title " Versão do Minecraft " --ok-label "Continuar" --cancel-label "Voltar" --inputbox "\nNão consegui buscar a lista de versões. Digite a versão (ex: 1.21.1):\n" 10 "$DW" "$MCVER") || return 1
    [ -z "$c" ] && return 1; MCVER=$c; return 0
  fi
  local -a items=()
  while read -r v; do
    if [ -z "$first" ]; then first=$v; items+=("$v" "mais recente"); else items+=("$v" ""); fi
  done <<<"$list"
  c=$(D --title " Versão do Minecraft " --ok-label "Continuar" --cancel-label "Voltar" --default-item "${MCVER:-$first}" --menu \
    "\nOs jogadores precisam usar a \Zbmesma versão\Zn no jogo.\n" "$DH" "$DW" 12 "${items[@]}") || return 1
  MCVER=$c
}
mc_details() {
  local vals; local -a v
  while :; do
    vals=$(D --title " Detalhes do servidor " --ok-label "Continuar" --cancel-label "Voltar" --form \
"
Tudo isso dá para mudar depois pelo painel.
" 11 "$DW" 3 \
      "      Nome no painel:" 1 1 "$SRVNAME" 1 23 40 40 \
      "     Mensagem (MOTD):" 2 1 "$MC_MOTD" 2 23 48 59 \
      "  Máximo de jogadores:" 3 1 "$MC_MAXP" 3 23 5 3) || return 1
    mapfile -t v <<<"$vals"
    SRVNAME=${v[0]:-}; MC_MOTD=${v[1]:-}; MC_MAXP=${v[2]:-}
    SRVNAME=${SRVNAME//[\"\\]/}; MC_MOTD=${MC_MOTD//\\/}
    [ -z "$SRVNAME" ] && { msg "Dê um nome ao servidor."; continue; }
    if ! [[ $MC_MAXP =~ ^[0-9]+$ ]] || (( MC_MAXP < 1 || MC_MAXP > 200 )); then msg "Máximo de jogadores: um número de 1 a 200."; continue; fi
    return 0
  done
}
mc_diff() {
  local c
  c=$(D --title " Dificuldade " --no-tags --ok-label "Continuar" --cancel-label "Voltar" --default-item "$MC_DIFF" --menu "\nDificuldade do mundo:\n" 0 "$DW" 0 \
    peaceful "Pacífico: sem monstros" \
    easy     "Fácil" \
    normal   "Normal" \
    hard     "Difícil") || return 1
  MC_DIFF=$c
}
mc_opt() {
  local extra="" rc
  [ "$MCTYPE" = fabric ] && extra="$NL   • instala mods de performance (Lithium, FerriteCore, Krypton, C2ME)"
  local vd="$NL   • diminui view/simulation distance (6/4 em vez de 10/10)"
  [ "$MCTYPE" = nenhum ] && vd=""
  D --title " Otimizações " --yes-label "Otimizar" --extra-button --extra-label "Deixar padrão" --no-label "Voltar" \
    $($OPTIMIZE || echo --default-button extra) --yesno \
"
Recomendado para hardware fraco (notebook antigo, CPU dual-core):
$vd
   • destrava CPUs Dell/Haswell presas em ~800 MHz (BD PROCHOT)$extra

Se preferir, instalo o padrão e você ajusta pelo painel.
" 0 "$DW"
  rc=$?
  case $rc in 0) OPTIMIZE=true ;; 3) OPTIMIZE=false ;; *) return 1 ;; esac
}
mc_eula() {
  local rc
  D --title " EULA do Minecraft " --yes-label "Aceito" --extra-button --extra-label "Não aceito" --no-label "Voltar" --yesno \
"
Para rodar um servidor de Minecraft é preciso aceitar o Contrato de
Licença (EULA) da Mojang:

      \Zbhttps://aka.ms/MinecraftEULA\Zn

Sem aceitar, o servidor é instalado mas fica parado (dá para aceitar
depois pelo painel).
" 0 "$DW"
  rc=$?
  case $rc in 0) EULA=true ;; 3) EULA=false ;; *) return 1 ;; esac
}
# "Nenhum agora" pula versão/detalhes/dificuldade/EULA; "Voltar" na 1ª subetapa
# volta pro tipo de servidor
scr_minecraft() {
  bt "Minecraft"
  while :; do
    mc_type || return 1
    if [ "$MCTYPE" = nenhum ]; then
      mc_opt && return 0
    else
      wizard mc_version mc_details mc_diff mc_opt mc_eula && return 0
    fi
  done
}

# ---------------------------------------------------------------------------
# 8) Painel web
# ---------------------------------------------------------------------------
scr_panel() {
  bt "Painel web"
  local c vals; local -a v
  while :; do
    c=$(D --title " Painel web " --no-tags --ok-label "Continuar" --cancel-label "Voltar" --default-item "$($PANEL_SAME && echo mesma || echo outra)" --menu \
"
O painel web (porta 8080) é onde você liga/desliga servidores, instala
mods e plugins, vê o console e faz backups, tudo pelo navegador.

Qual senha usar para entrar no painel?
" 0 "$DW" 0 \
      mesma "A mesma senha do usuário $USERNAME" \
      outra "Definir uma senha diferente") || return 1
    if [ "$c" = mesma ]; then PANEL_SAME=true; PANELPW=$USERPW; return 0; fi
    vals=$(D --title " Senha do painel " --ok-label "Continuar" --cancel-label "Voltar" --insecure --mixedform "\n" 10 "$DW" 2 \
      "     Senha do painel:" 1 1 "" 1 23 40 128 1 \
      "    Confirme a senha:" 2 1 "" 2 23 40 128 1) || continue
    mapfile -t v <<<"$vals"
    if [ ${#v[0]} -lt 6 ]; then msg "A senha precisa ter pelo menos 6 caracteres."; continue; fi
    if [ "${v[0]}" != "${v[1]:-}" ]; then msg "As senhas não batem."; continue; fi
    PANEL_SAME=false; PANELPW=${v[0]}; return 0
  done
}

# ---------------------------------------------------------------------------
# 9) Resumo + confirmação destrutiva
# ---------------------------------------------------------------------------
scr_summary() {
  bt "Resumo"
  local net ssh diffpt
  if [ -n "$STATIC_IF" ]; then net="IP fixo $STATIC_ADDR em $STATIC_IF"; else net="automática (DHCP)"; fi
  [ -n "$WIFI_SSID" ] && net="$net, Wi-Fi \"$WIFI_SSID\""
  ssh="$(ssh_count) chave(s)"; if $SSH_PWAUTH; then ssh="$ssh, senha permitida"; else ssh="$ssh, senha bloqueada"; fi
  case "$MC_DIFF" in peaceful) diffpt="pacífico";; easy) diffpt="fácil";; hard) diffpt="difícil";; *) diffpt="normal";; esac
  local srvl="Servidor:       $SRVNAME: $MCTYPE $MCVER, até $MC_MAXP jogadores, $diffpt
  Memória Java:   $(heap_mb) MB (calculado pela RAM de $(human_ram))" eulal
  eulal="$NL  EULA:           $($EULA && echo aceita || echo "não aceita (servidor fica parado)")"
  if [ "$MCTYPE" = nenhum ]; then srvl="Servidor:       nenhum agora (crie pelo painel depois)"; eulal=""; fi
  D --title " Resumo da instalação " --yes-label "Instalar" --no-label "Voltar" --yesno \
"
  Disco:          \Zb$DISK\Zn ($(lsblk -dno SIZE "$DISK" 2>/dev/null | tr -d ' ')), será apagado inteiro
  Teclado:        $KEYMAP
  Rede:           $net
  Máquina:        $SRV_HOST   (usuário: $USERNAME)
  SSH:            $ssh
  $srvl
  Otimizações:    $($OPTIMIZE && echo sim || echo não)$eulal
  Painel web:     porta 8080, $($PANEL_SAME && echo "mesma senha do usuário" || echo "senha própria")

Revise e escolha \ZbInstalar\Zn. Ainda dá para voltar e mudar qualquer coisa.
" 0 "$DW" || return 1
  D --title " Confirmar ação destrutiva " --defaultno --yes-label "Continuar" --no-label "Voltar" --yesno \
"
Se você continuar, o disco \Zb$DISK\Zn será \Z1\Zbapagado por completo\Zn e o
craftbox será instalado nele.

\Z1Não tem como desfazer.\Zn Tudo que estiver nesse disco será perdido.

Tem certeza?
" 13 "$DW" || return 1
  return 0
}

# ---------------------------------------------------------------------------
# instalação (roda em segundo plano; progresso em $STATE, saída em $LOG)
# ---------------------------------------------------------------------------
PHASES=("Particionando o disco" "Formatando" "Instalando o sistema base" "Baixando o Minecraft" "Configurando o sistema" "Instalando o gerenciador de boot" "Finalizando")
PH_START=(0 3 5 70 80 90 96)
PH_END=(3 5 70 80 90 96 100)
phase() { echo "$1" > "$STATE"; echo; echo "==> [$(( $1 + 1 ))/${#PHASES[@]}] ${PHASES[$1]}"; }
fail() { echo "ERRO: $*"; echo "FAIL:$*" > "$STATE"; exit 1; }
info() { echo "  - $*"; }

do_install_dry() {
  local i k
  for i in "${!PHASES[@]}"; do
    phase "$i"
    if [ "$i" -eq 2 ]; then for k in $(seq 1 40); do echo "(${k}/40) installing pacote-$k..."; sleep 0.1; done
    else for k in 1 2 3; do info "simulando passo $k"; sleep 0.4; done; fi
    [ "$i" -eq 3 ] && [ -n "${CB_DRY_FAIL:-}" ] && fail "falha simulada ($CB_DRY_FAIL)"
  done
  echo DONE > "$STATE"
}

do_install() {
  local SDIR=/srv/minecraft SRVID MCDIR HEAP
  HEAP=$(heap_mb)
  timedatectl set-ntp true 2>/dev/null || true
  part_names

  phase 0
  umount -R /mnt 2>/dev/null || true
  swapoff -a 2>/dev/null || true
  wipefs -af "$DISK" || fail "não consegui limpar $DISK"
  sgdisk -Z "$DISK" >/dev/null 2>&1
  sgdisk -n1:0:+512M -t1:ef00 -c1:ESP "$DISK" || fail "sgdisk (ESP) falhou"
  sgdisk -n2:0:0 -t2:8300 -c2:root "$DISK" || fail "sgdisk (root) falhou"
  partprobe "$DISK"; udevadm settle; sleep 2
  info "ESP=$P1  root=$P2"

  phase 1
  mkfs.fat -F32 -n ESP "$P1" || fail "mkfs.fat falhou"
  mkfs.ext4 -F -L root "$P2" || fail "mkfs.ext4 falhou"
  mount "$P2" /mnt || fail "não consegui montar $P2"
  mkdir -p /mnt/boot && mount "$P1" /mnt/boot || fail "não consegui montar $P1"

  phase 2
  # o painel é um binário Rust embarcado na ISO; o Node só entra como fallback
  # (ISO montada sem o binário)
  local node_pkg=""
  [ -x /opt/craftbox-panel/craftbox-panel ] || node_pkg=nodejs
  pacstrap -K /mnt \
    base linux linux-firmware mkinitcpio intel-ucode \
    "${CB_PACKAGES[@]}" $node_pkg || fail "pacstrap falhou (rede ou espelho do Arch fora do ar?)"
  # várias JDKs (o painel escolhe por versão do MC: 8 ≤1.16, 17 até 1.20.4, 21 até
  # 1.21.x, a mais nova pras versões por calendário); o `java` padrão é a mais nova
  arch-chroot /mnt bash -c '. /dev/stdin; cb_java_default_newest' < /usr/local/lib/craftbox/system.sh
  genfstab -U /mnt >> /mnt/etc/fstab
  info "criando swap de 2 GB"
  if dd if=/dev/zero of=/mnt/swapfile bs=1M count=2048 status=none && chmod 600 /mnt/swapfile && mkswap /mnt/swapfile >/dev/null; then
    echo '/swapfile none swap defaults 0 0' >> /mnt/etc/fstab
  else info "aviso: swap não criado"; rm -f /mnt/swapfile; fi

  phase 3
  SRVID=""
  if [ "$MCTYPE" = nenhum ]; then
    info "nenhum servidor inicial: crie pelo painel (nada foi baixado, nenhum mundo gerado)"
    mkdir -p "/mnt$SDIR"
  else
  SRVID=$(printf '%s' "$SRVNAME" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//')
  [ -z "$SRVID" ] && SRVID=principal
  MCDIR=/mnt$SDIR/$SRVID
  mkdir -p "$MCDIR/mods" "$MCDIR/plugins" "$MCDIR/backups"
  echo "$MCTYPE" > "$MCDIR/.craftbox-loader"
  if [ "$MCTYPE" = paper ]; then
    local dl url build
    dl=$(curl -fsSL -A "$UA" "https://fill.papermc.io/v3/projects/paper/versions/$MCVER/builds/latest") || fail "não achei build do Paper para $MCVER"
    build=$(jq -r '.id' <<<"$dl"); url=$(jq -r '.downloads."server:default".url' <<<"$dl")
    [ -n "$url" ] && [ "$url" != null ] || fail "não achei build do Paper para $MCVER"
    curl -fL --retry 3 -sS -A "$UA" -o "$MCDIR/server.jar" "$url" || fail "falha ao baixar o Paper"
    info "Paper $MCVER build $build"
  else
    local loader inst slug url
    loader=$(curl -fsSL https://meta.fabricmc.net/v2/versions/loader | jq -r '[.[]|select(.stable==true)][0].version')
    inst=$(curl -fsSL https://meta.fabricmc.net/v2/versions/installer | jq -r '[.[]|select(.stable==true)][0].version')
    curl -fL --retry 3 -sS -o "$MCDIR/server.jar" "https://meta.fabricmc.net/v2/versions/loader/$MCVER/$loader/$inst/server/jar" \
      || fail "falha ao baixar o Fabric $MCVER"
    info "Fabric $MCVER (loader $loader)"
    if $OPTIMIZE; then
      for slug in fabric-api lithium ferrite-core krypton c2me-fabric; do
        url=$(curl -fsSL "https://api.modrinth.com/v2/project/$slug/version?loaders=%5B%22fabric%22%5D&game_versions=%5B%22$MCVER%22%5D" \
              | jq -r '.[0].files[]? | select(.primary==true) | .url' 2>/dev/null | head -1)
        if [ -n "${url:-}" ] && [ "$url" != null ]; then curl -fL --retry 2 -sS -o "$MCDIR/mods/$slug.jar" "$url" && info "mod: $slug"
        else info "sem build de $slug para $MCVER (pulei)"; fi
      done
    fi
  fi
  jq -n --arg name "$SRVNAME" --arg loader "$MCTYPE" --arg v "$MCVER" \
    '{name:$name, loader:$loader, mcVersion:$v, port:25565, createdAt:0}' > "$MCDIR/.craftbox-instance.json"
  printf '# gerado pelo instalador — https://aka.ms/MinecraftEULA\neula=%s\n' "$EULA" > "$MCDIR/eula.txt"
  local vdist=10 sdist=10; $OPTIMIZE && { vdist=6; sdist=4; }
  cat > "$MCDIR/server.properties" <<EOF
# view/simulation distance conforme o modo escolhido na instalacao. Edite pelo painel.
motd=$MC_MOTD
max-players=$MC_MAXP
difficulty=$MC_DIFF
online-mode=true
view-distance=$vdist
simulation-distance=$sdist
network-compression-threshold=256
enable-command-block=true
spawn-protection=0
enable-rcon=true
rcon.port=25575
rcon.password=$(head -c16 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c12)
server-port=25565
EOF
  # mesma tabela do java_for_mc do painel: AA.x → 25, 1.20.5+ → 21, 1.17+ → 17, senão 8
  local jmajor jladder XMS=$HEAP mn pt
  if [[ "$MCVER" =~ ^[0-9]{2}\. ]]; then jmajor=25
  else
    mn=$(cut -d. -f2 <<<"$MCVER"); pt=$(cut -d. -f3 <<<"$MCVER"); pt=${pt:-0}
    if (( mn >= 21 || (mn == 20 && pt >= 5) )); then jmajor=21
    elif (( mn >= 17 )); then jmajor=17; else jmajor=8; fi
  fi
  jladder=$(for v in 8 11 17 21 25; do (( v >= jmajor )) && printf '%s ' "$v"; done)
  # pouca RAM: não reserva o heap todo de cara (-Xms = -Xmx + AlwaysPreTouch empurra pro swap)
  (( HEAP < 2048 )) && XMS=512
  cat > "$MCDIR/start.sh" <<EOF
#!/usr/bin/env bash
cd "\$(dirname "\$0")"
# JDK da versão do MC (a mesma escolha que o painel faz nos servidores que ele cria)
export CRAFTBOX_JAVA_MAJOR=$jmajor
JAVA=/usr/bin/java
for v in $jladder; do
  [ -x "/usr/lib/jvm/java-\$v-openjdk/bin/java" ] && { JAVA="/usr/lib/jvm/java-\$v-openjdk/bin/java"; break; }
done
exec "\$JAVA" \\
  -Xms${XMS}M -Xmx${HEAP}M \\
  -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 \\
  -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch \\
  -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M \\
  -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 \\
  -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 \\
  -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 \\
  -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 \\
  -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true \\
  -jar server.jar --nogui
EOF
  cat > "$MCDIR/backup.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
ts=$(date +%Y%m%d-%H%M)
tar czf "backups/world-$ts.tar.gz" world world_nether world_the_end 2>/dev/null || \
  tar czf "backups/world-$ts.tar.gz" world 2>/dev/null || true
# mantem os 7 backups mais recentes
ls -1t backups/world-*.tar.gz 2>/dev/null | tail -n +8 | xargs -r rm -f
EOF
  chmod +x "$MCDIR/start.sh" "$MCDIR/backup.sh"
  fi  # servidor inicial

  phase 4
  # rede: Wi-Fi e/ou IP fixo viram conexões do NetworkManager
  local nmdir=/mnt/etc/NetworkManager/system-connections ipv4="method=auto" d dnsl=""
  mkdir -p "$nmdir"
  if [ -n "$STATIC_IF" ]; then
    for d in ${STATIC_DNS//,/ }; do dnsl+="$d;"; done
    ipv4="method=manual${NL}address1=$STATIC_ADDR,$STATIC_GW${NL}dns=$dnsl"
  fi
  if [ -n "$WIFI_SSID" ]; then
    { printf '[connection]\nid=craftbox-wifi\ntype=wifi\nautoconnect=true\n[wifi]\nssid=%s\nmode=infrastructure\n' "$WIFI_SSID"
      $WIFI_HIDDEN && printf 'hidden=true\n'
      [ -n "$WIFI_PASS" ] && printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n' "$WIFI_PASS"
      if [ "$STATIC_IF" = "$WIFI_IF" ]; then printf '[ipv4]\n%s\n' "$ipv4"; else printf '[ipv4]\nmethod=auto\n'; fi
      printf '[ipv6]\nmethod=auto\n'
    } > "$nmdir/craftbox-wifi.nmconnection"
    info "Wi-Fi \"$WIFI_SSID\" salvo"
  fi
  if [ -n "$STATIC_IF" ] && [ "$STATIC_IF" != "$WIFI_IF" ]; then
    printf '[connection]\nid=craftbox-cabo\ntype=ethernet\ninterface-name=%s\nautoconnect=true\n[ipv4]\n%s\n[ipv6]\nmethod=auto\n' "$STATIC_IF" "$ipv4" \
      > "$nmdir/craftbox-cabo.nmconnection"
    info "IP fixo $STATIC_ADDR em $STATIC_IF"
  fi
  chmod 600 "$nmdir"/*.nmconnection 2>/dev/null

  # tampa fechada não desliga
  mkdir -p /mnt/etc/systemd/logind.conf.d
  printf '[Login]\nHandleLidSwitch=ignore\nHandleLidSwitchExternalPower=ignore\nHandleLidSwitchDocked=ignore\n' > /mnt/etc/systemd/logind.conf.d/lid.conf

  local mid=${SRVID:-<nome>} srvline="servidor inicial: $SRVNAME · $MCTYPE" issue_srv="Servidor \"$SRVNAME\" ($MCTYPE) na porta 25565."
  if [ -z "$SRVID" ]; then srvline="sem servidor ainda: crie pelo painel"; issue_srv="Nenhum servidor ainda: crie o primeiro pelo painel."; fi
  cat > /mnt/etc/motd <<EOF

  craftbox — $SRV_HOST   ($srvline)
  ------------------------------------------------------------
  painel web:  http://<ip-desta-maquina>:8080
  status:      systemctl status minecraft@$mid
  logs:        journalctl -u minecraft@$mid -f
  reiniciar:   sudo systemctl restart minecraft@$mid
  instancias:  /srv/minecraft/<nome>    (gerencie tudo pelo painel)
  painel:      /opt/craftbox-panel

EOF
  # tela de boas-vindas no console (acima do "login:") — o agetty troca \4 pelo IP real
  cat > /mnt/etc/issue <<ISSUE

  ============================================================
   craftbox  -  $SRV_HOST
  ============================================================

   >> Painel web:   http://\\4:8080
   >> Entrar SSH:   ssh $USERNAME@\\4

   $issue_srv
   Abra o painel no navegador pra gerenciar tudo.

ISSUE

  # SSH: login por senha conforme escolhido; root nunca
  mkdir -p /mnt/etc/ssh/sshd_config.d
  { if $SSH_PWAUTH; then echo 'PasswordAuthentication yes'; else echo 'PasswordAuthentication no'; fi
    echo 'PermitRootLogin no'; } > /mnt/etc/ssh/sshd_config.d/10-craftbox.conf

  # painel web: copia pro sistema instalado (vem embarcado na ISO em /opt/craftbox-panel)
  if [ -d /opt/craftbox-panel ]; then
    mkdir -p /mnt/opt/craftbox-panel
    cp -rT /opt/craftbox-panel /mnt/opt/craftbox-panel
    rm -f /mnt/opt/craftbox-panel/config.json
    info "painel copiado para /opt/craftbox-panel"
  else
    info "aviso: painel não encontrado no live (/opt/craftbox-panel)"
  fi
  # fix do BD PROCHOT (CPU presa em ~800 MHz em Dell/Haswell); só é habilitado se otimizado
  if [ -f /usr/local/bin/craftbox-bdprochot ]; then
    install -Dm755 /usr/local/bin/craftbox-bdprochot /mnt/usr/local/bin/craftbox-bdprochot
    install -Dm644 /etc/systemd/system/craftbox-bdprochot.service /mnt/etc/systemd/system/craftbox-bdprochot.service
    install -Dm644 /etc/modules-load.d/msr.conf /mnt/etc/modules-load.d/msr.conf 2>/dev/null || true
  fi

  # updater (sincroniza com as releases do GitHub) + versão instalada
  install -Dm755 /usr/local/bin/craftbox-update /mnt/usr/local/bin/craftbox-update
  install -Dm755 /usr/local/lib/craftbox/system.sh /mnt/usr/local/lib/craftbox/system.sh
  if [ -f /etc/craftbox-release ]; then cp /etc/craftbox-release /mnt/etc/craftbox-release
  else printf 'VERSION=%s\n' "$CB_VERSION" > /mnt/etc/craftbox-release; fi

  # painel: binário Rust (lê config.json e public/ ao lado dele) ou, sem ele, o server.js
  local panel_exec
  panel_exec=$(CB_ROOT=/mnt cb_panel_exec)
  info "painel: $panel_exec"
  # units (minecraft@, mc-backup@, craftbox-panel) e sudoers: fonte única no system.sh,
  # a mesma que o craftbox-update usa depois
  CB_ROOT=/mnt cb_write_units
  CB_ROOT=/mnt cb_write_sudoers || fail "sudoers do painel inválido"

  # configuração dentro do chroot (só valores já validados; senhas vão por stdin, fora do script)
  cat > /mnt/root/chroot-setup.sh <<CHROOT
#!/usr/bin/env bash
set -euo pipefail
ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
hwclock --systohc || true
sed -i 's/^#\(pt_BR.UTF-8\)/\1/; s/^#\(en_US.UTF-8\)/\1/' /etc/locale.gen
locale-gen
echo 'LANG=pt_BR.UTF-8' > /etc/locale.conf
printf 'KEYMAP=%s\nFONT=eurlatgr\n' '$KEYMAP' > /etc/vconsole.conf
echo '$SRV_HOST' > /etc/hostname
printf '127.0.0.1   localhost\n::1         localhost\n127.0.1.1   $SRV_HOST.localdomain $SRV_HOST\n' > /etc/hosts

useradd -m -G wheel -s /bin/bash -c "\$(cat /root/.cb-fullname)" '$USERNAME'
rm -f /root/.cb-fullname
passwd -l root
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/wheel
chmod 440 /etc/sudoers.d/wheel

useradd -r -m -d /srv/minecraft -s /usr/bin/nologin minecraft || true
chown -R minecraft:minecraft /srv/minecraft
find /srv/minecraft -name '*.sh' -exec chmod +x {} +
mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/minecraft

systemctl enable NetworkManager sshd systemd-timesyncd
$([ -n "$SRVID" ] && printf 'systemctl enable minecraft@%s mc-backup@%s.timer' "$SRVID" "$SRVID")
[ -d /opt/craftbox-panel ] && systemctl enable craftbox-panel || true
if [ "$OPTIMIZE" = "true" ] && [ -f /etc/systemd/system/craftbox-bdprochot.service ]; then
  systemctl enable craftbox-bdprochot || true
fi
CHROOT
  chmod +x /mnt/root/chroot-setup.sh
  printf '%s' "$FULLNAME" > /mnt/root/.cb-fullname
  arch-chroot /mnt /root/chroot-setup.sh || fail "configuração no chroot falhou"
  rm -f /mnt/root/chroot-setup.sh
  printf '%s:%s\n' "$USERNAME" "$USERPW" | arch-chroot /mnt chpasswd || fail "não consegui definir a senha do usuário"
  if [ -n "$SSH_KEYS" ]; then
    install -d -m700 "/mnt/home/$USERNAME/.ssh"
    printf '%s\n' "$SSH_KEYS" > "/mnt/home/$USERNAME/.ssh/authorized_keys"
    chmod 600 "/mnt/home/$USERNAME/.ssh/authorized_keys"
    arch-chroot /mnt chown -R "$USERNAME:$USERNAME" "/home/$USERNAME/.ssh"
    info "$(ssh_count) chave(s) SSH instalada(s)"
  fi
  # painel: config com hash da senha (a senha vai como argumento, nunca pro log)
  if [ -d /mnt/opt/craftbox-panel ]; then
    local phash psecret
    phash=$(arch-chroot /mnt $panel_exec --hash "$PANELPW" | tail -n +2) || fail "não consegui gerar o hash da senha do painel"
    psecret=$(head -c32 /dev/urandom | od -An -tx1 | tr -d ' \n')
    cat > /mnt/opt/craftbox-panel/config.json <<PCFG
{
  "port": 8080,
  "host": "0.0.0.0",
  "serversDir": "/srv/minecraft",
  "serviceTemplate": "minecraft@",
  "activeServer": "$SRVID",
  "systemctlUser": false,
  "integrationsDir": "/srv/minecraft/.craftbox-integrations",
  "auditLog": "/srv/minecraft/.craftbox-audit.log",
  "rcon": { "host": "127.0.0.1", "port": 25575, "password": "" },
  "auth": $phash,
  "sessionSecret": "$psecret"
}
PCFG
    arch-chroot /mnt chown -R minecraft:minecraft /opt/craftbox-panel
    chmod 600 /mnt/opt/craftbox-panel/config.json
  fi

  phase 5
  local root_uuid
  arch-chroot /mnt bootctl install || fail "bootctl install falhou"
  root_uuid=$(blkid -s PARTUUID -o value "$P2")
  printf 'default craftbox.conf\ntimeout 1\nconsole-mode max\neditor no\n' > /mnt/boot/loader/loader.conf
  printf 'title   craftbox\nlinux   /vmlinuz-linux\ninitrd  /intel-ucode.img\ninitrd  /initramfs-linux.img\noptions root=PARTUUID=%s rw quiet\n' "$root_uuid" \
    > /mnt/boot/loader/entries/craftbox.conf
  arch-chroot /mnt mkinitcpio -P || fail "mkinitcpio falhou"

  phase 6
  mkdir -p /mnt/var/log
  cp "$LOG" /mnt/var/log/craftbox-install.log 2>/dev/null
  sync
  umount -R /mnt || true
  echo DONE > "$STATE"
}

progress_ui() {
  BT="craftbox $CB_VERSION  ·  Instalador$($DRYRUN && echo '  ·  SIMULAÇÃO')      instalando..."
  local pid=$1 st i pct cur lines txt spin='|/-\' k=0 done_n tot
  {
    while :; do
      st=$(cat "$STATE" 2>/dev/null)
      [[ "$st" == DONE || "$st" == FAIL* ]] && break
      cur=${st:-0}; [[ $cur =~ ^[0-9]+$ ]] || cur=0
      pct=${PH_START[cur]}
      if [ "$cur" -eq 2 ]; then
        # pacstrap: "(12/180) installing foo" → progresso dentro da fase
        done_n=""; tot=""
        read -r done_n tot < <(grep -aoE '^\( *[0-9]+/[0-9]+\) installing' "$LOG" | tail -1 | tr -d '() ' | sed 's/installing//; s|/| |')
        if [ -n "${tot:-}" ] && (( tot > 0 )); then pct=$(( PH_START[2] + (PH_END[2] - PH_START[2]) * done_n / tot )); fi
      fi
      txt=""
      for i in "${!PHASES[@]}"; do
        if (( i < cur )); then txt+="   [\Z2ok\Zn] ${PHASES[i]}$NL"
        elif (( i == cur )); then txt+="   [\Z3${spin:k%4:1}\Zn ] \Zb${PHASES[i]}\Zn$NL"
        else txt+="   [  ] ${PHASES[i]}$NL"; fi
      done
      lines=$(tail -n 5 "$LOG" 2>/dev/null | tr -d '\r\\' | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | cut -c1-$(( DW - 8 )) | sed 's/^/   /')
      printf 'XXX\n%d\n\n%s\n   ─── últimas linhas do log ───\n%s\nXXX\n' "$pct" "$txt" "$lines"
      k=$((k + 1)); sleep 1
    done
  } | D --title " Instalando o craftbox " --gauge "" "$DH" "$DW" 0
  wait "$pid" 2>/dev/null
}

scr_done() {
  local ip c
  ip=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
  [ -n "$STATIC_ADDR" ] && ip=${STATIC_ADDR%/*}
  BT="craftbox $CB_VERSION  ·  Instalador      concluído"
  local done_srv="O craftbox foi instalado. Ao reiniciar, o servidor \Zb$SRVNAME\Zn sobe
sozinho na porta 25565."
  [ "$MCTYPE" = nenhum ] && done_srv="O craftbox foi instalado, sem nenhum servidor ainda. Depois de
reiniciar, abra o painel e crie o primeiro (Paper, Fabric, Forge, modpack...)."
  while :; do
    c=$(D --title " Instalação concluída! " --no-tags --no-cancel --ok-label "Selecionar" --menu \
"
$done_srv

   Painel web:   \Zbhttp://${ip:-<ip-da-máquina>}:8080\Zn
   SSH:          ssh $USERNAME@${ip:-<ip-da-máquina>}

\Z3Tire o pendrive\Zn quando a tela apagar. O endereço do painel também
aparece na tela da máquina, acima do login.
" 0 "$DW" 0 \
      reiniciar "Reiniciar agora" \
      log       "Ver o log da instalação" \
      terminal  "Sair para o terminal") || continue
    case "$c" in
      reiniciar) $DRYRUN && exit 0; reboot ;;
      log) D --title " Log da instalação " --exit-label "Voltar" --textbox "$LOG" "$DH" "$DW" ;;
      terminal) exit 0 ;;
    esac
  done
}
scr_failed() {
  local why=${1#FAIL:} c
  BT="craftbox $CB_VERSION  ·  Instalador      erro"
  while :; do
    c=$(D --title " A instalação falhou " --no-tags --no-cancel --ok-label "Selecionar" --menu \
"
\Z1\Zb$why\Zn

Últimas linhas do log:
$(tail -n 7 "$LOG" | tr -d '\\' | cut -c1-$(( DW - 8 )) | sed 's/^/   /')
" 0 "$DW" 0 \
      log       "Ver o log completo" \
      denovo    "Voltar ao resumo e tentar de novo" \
      terminal  "Sair para o terminal" \
      reiniciar "Reiniciar") || continue
    case "$c" in
      log) D --title " Log da instalação " --exit-label "Voltar" --textbox "$LOG" "$DH" "$DW" ;;
      denovo) return 0 ;;
      terminal) EXIT_MSG="Log da instalação: $LOG   (para tentar de novo: mc-install)"; exit 1 ;;
      reiniciar) $DRYRUN && exit 1; reboot ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
[ -t 0 ] && [ -t 1 ] || { echo "mc-install precisa de um terminal." >&2; exit 1; }
command -v "$DIALOG" >/dev/null 2>&1 || { echo "mc-install: '$DIALOG' não encontrado." >&2; exit 1; }
if ! $DRYRUN && [ "$(id -u)" -ne 0 ]; then echo "mc-install precisa rodar como root (ou use --dry-run)." >&2; exit 1; fi
setup_theme; fit_screen

SCREENS=(scr_welcome scr_keyboard scr_network scr_storage scr_profile scr_ssh scr_minecraft scr_panel scr_summary)
top_wizard "${SCREENS[@]}"
while :; do
  : > "$LOG"; echo 0 > "$STATE"
  if $DRYRUN; then do_install_dry >> "$LOG" 2>&1 & else do_install >> "$LOG" 2>&1 & fi
  progress_ui $!
  st=$(cat "$STATE")
  [ "$st" = DONE ] && scr_done
  scr_failed "$st"
  WIZ_START=$(( ${#SCREENS[@]} - 1 )) top_wizard "${SCREENS[@]}"
done
